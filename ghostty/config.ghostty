theme = Ayu Light

fullscreen = false
window-padding-x = 15
shell-integration = fish
shell-integration-features = no-cursor

font-family = "FiraCode Nerd Font"
font-size = 14

adjust-underline-position = 150%
adjust-cell-height = 10
cursor-style = block
cursor-style-blink = true

gtk-wide-tabs = false

keybind = ctrl+shift+t=new_tab
keybind = ctrl+q=close_tab
keybind = ctrl+shift+h=previous_tab
keybind = ctrl+shift+l=next_tab

keybind = ctrl+shift+n=new_split:right
keybind = ctrl+shift+p=goto_split:left
