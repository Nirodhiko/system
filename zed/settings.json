// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "language_models": {
    "openai_compatible": {
      "GLM": {
        "api_url": "https://open.bigmodel.cn/api/paas/v4/",
        "available_models": [
          {
            "name": "glm-5.2",
            "max_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": true,
              "chat_completions": true,
              "interleaved_reasoning": false,
            },
          },
        ],
      },
    },
  },
  "edit_predictions": {
    "provider": "zed",
    "open_ai_compatible_api": {
      "prompt_format": "infer",
      "model": "glm-5.2",
      "api_url": "https://open.bigmodel.cn/api/paas/v4/",
    },
  },
  "ssh_connections": [
    {
      "host": "nirodhiko.link",
      "username": "admin",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/admin/docker"
          ]
        }
      ]
    }
  ],
  "agent_servers": {
    "opencode": {
      "type": "registry",
    },
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Material Icon Theme",
  },
  "cli_default_open_behavior": "existing_window",
  "buffer_font_family": ".ZedMono",
  "ui_font_family": ".ZedSans",
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "sandbox_permissions": {
      "network_hosts": [
        "wiki.nixos.org",
        "raw.githubusercontent.com",
        "extensions.gnome.org",
        "search.nixos.org",
        "github.com",
        "api.nixos.org",
        "ghostty.org",
        "pwmt.org",
        "manpages.debian.org",
        "api.github.com",
        "zen-browser.app",
        "lazamar.co.uk",
        "www.cups.org",
        "wiki.archlinux.org"
      ]
    },
    "tool_permissions": {
      "tools": {
        "skill": {
          "default": "allow",
        },
        "mcp:mcp-server-context7:resolve-library-id": {
          "default": "allow",
        },
        "mcp:mcp-server-context7:query-docs": {
          "default": "allow",
        },
        "terminal": {
          "default": "allow",
        },
        "fetch": {
          "default": "allow",
        },
      },
    },
    "default_profile": "write",
    "sidebar_side": "right",
    "default_model": {
      "effort": "high",
      "provider": "deepseek",
      "model": "deepseek-v4-pro",
      "enable_thinking": true,
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "outline_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "project_panel": {
    "dock": "left",
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Dracula Light (Alucard",
    "dark": "Catppuccin Macchiato",
  },
  "languages": {
    "Nix": {
      "language_servers": ["nixd", "!nil"],
    },
  },
}
