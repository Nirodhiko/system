# ===== 基础重新着色=====
set recolor              true
set recolor-lightcolor   "#FAF3E0"
set recolor-darkcolor    "#2E2E2E"
set recolor-keephue      true
set default-bg           "#FAF3E0"

# ===== 状态栏(底部信息栏)=====
set statusbar-fg         "#5C5347"
set statusbar-bg         "#EDE4D3"

# ===== 输入栏(命令行 : 模式)=====
set inputbar-fg          "#2E2E2E"
set inputbar-bg          "#EDE4D3"

# ===== 补全列表(命令补全、书签等)=====
set completion-bg              "#EDE4D3"
set completion-fg              "#2E2E2E"
set completion-group-bg        "#DCD0B8"
set completion-group-fg        "#5C5347"
set completion-highlight-bg    "#C9A876"
set completion-highlight-fg    "#2E2E2E"

# ===== 通知提示(错误/警告/普通消息)=====
set notification-bg            "#EDE4D3"
set notification-fg            "#2E2E2E"
set notification-error-bg      "#E8B4A0"
set notification-error-fg      "#6B2E1F"
set notification-warning-bg    "#F0D9A0"
set notification-warning-fg    "#5C4A1F"

# ===== 目录索引(Table of Contents,按 Tab 打开)=====
set index-fg              "#2E2E2E"
set index-bg              "#FAF3E0"
set index-active-fg       "#FAF3E0"
set index-active-bg       "#B08D57"

# ===== 搜索高亮 =====
set highlight-color        "#F0D9A0"
set highlight-active-color "#C9A876"
set highlight-fg           "#2E2E2E"

# ===== 加载提示 =====
set render-loading-bg      "#FAF3E0"
set render-loading-fg      "#5C5347"

# ===== 其它细节 =====
set statusbar-h-padding    5
set statusbar-v-padding    3
set selection-clipboard    clipboard