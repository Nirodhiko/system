global-rounded-corner-settings={'padding': <{'left': uint32 1, 'right': 1, 'top': 1, 'bottom': 1}>, 'keepRoundedCorners': <{'maximized': false, 'fullscreen': false}>, 'borderRadius': <uint32 15>, 'smoothing': <0.0>, 'borderColor': <(0.5, 0.5, 0.5, 1.0)>, 'enabled': <true>}
settings-version=uint32 9
skip-libadwaita-app=false

[shell/extensions/unite]
hide-window-titlebars='always'

[shell/extensions/user-theme]
name=''

[shell/keybindings]
toggle-message-tray=@as []
toggle-overview=['<Super>o']
toggle-quick-settings=@as []

[shell/weather]
automatic-location=true
locations=[<(uint32 2, <('Karachi Airport', 'OPKC', false, [(0.43458698374658805, 1.1716976986877623)], @a(dd) [])>)>, <(uint32 2, <('Islamabad', 'OPRN', true, [(0.58672152269652456, 1.2758356832078548)], [(0.5881759579220891, 1.276999241860282)])>)>]

[shell/world-clocks]
locations=@av []

[system/location]
enabled=true

[tweaks]
show-extensions-notice=false
